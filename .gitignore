/bingle_jsi/example/android/build/
/bingle_jsi/example/android/app/build/
/bingle_jsi/example/android/app/.cxx/
/bingle_jsi/example/android/local.properties
/bingle_jsi/example/android/.kotlin/

# Ignore a bingle_jsi package
/bingle_jsi/package

