            "readonly": false,
            "desc": "Opt the application account into the provided ASA.\nAdmin-only: must be called by the application creator. Performs an inner asset transfer of 0 to the app's own address to complete the opt-in.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "set_bingle_price",
            "args": [
                {
                    "type": "uint64",
                    "name": "price"
                }
